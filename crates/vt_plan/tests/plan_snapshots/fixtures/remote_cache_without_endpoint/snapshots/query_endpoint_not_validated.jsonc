// run build
{
  "graph": [
    {
      "key": [
        "<workspace>/",
        "build"
      ],
      "node": {
        "items": [
          {
            "kind": {
              "Leaf": {
                "Spawn": {
                  "cache_metadata": {
                    "remote_cache": {
                      "mode": "read",
                      "url": "cache.example/projects/test"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
