// run --remote-cache=read env-off
{
  "graph": [
    {
      "key": [
        "<workspace>/",
        "env-off"
      ],
      "node": {
        "items": [
          {
            "kind": {
              "Expanded": {
                "graph": [
                  {
                    "key": [
                      "<workspace>/",
                      "build"
                    ],
                    "node": {
                      "items": [
                        {
                          "kind": {
                            "Leaf": {
                              "Spawn": {
                                "cache_metadata": {
                                  "spawn_fingerprint": {
                                    "env_fingerprints": {
                                      "fingerprinted_envs": {},
                                      "untracked_env_config": [
                                        "<default untracked envs>"
                                      ]
                                    }
                                  },
                                  "remote_cache": null
                                },
                                "spawn_command": {
                                  "spawn_envs": {}
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
