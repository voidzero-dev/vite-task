// run tracked-controls
{
  "graph": [
    {
      "key": [
        "<workspace>/",
        "tracked-controls"
      ],
      "node": {
        "items": [
          {
            "kind": {
              "Leaf": {
                "Spawn": {
                  "cache_metadata": {
                    "spawn_fingerprint": {
                      "env_fingerprints": {
                        "fingerprinted_envs": {},
                        "untracked_env_config": [
                          "VP_REMOTE_CACHE",
                          "VP_REMOTE_CACHE_URL",
                          "<default untracked envs>"
                        ]
                      }
                    },
                    "remote_cache": {
                      "mode": "read-write",
                      "url": "https://other.example/projects/test"
                    }
                  },
                  "spawn_command": {
                    "spawn_envs": {
                      "VP_REMOTE_CACHE": "read-write",
                      "VP_REMOTE_CACHE_URL": "https://other.example/projects/test"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
