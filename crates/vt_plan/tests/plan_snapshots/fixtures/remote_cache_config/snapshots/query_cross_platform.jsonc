// run cross-platform
{
  "graph": [
    {
      "key": [
        "<workspace>/",
        "cross-platform"
      ],
      "node": {
        "items": [
          {
            "kind": {
              "Leaf": {
                "Spawn": {
                  "cache_metadata": {
                    "spawn_fingerprint": {
                      "env_fingerprints": {
                        "fingerprinted_envs": {},
                        "untracked_env_config": [
                          "<default untracked envs>"
                        ]
                      }
                    },
                    "remote_cache": {
                      "access": "read",
                      "url": "https://cache.example/projects/test",
                      "auth": {
                        "kind": "anonymous"
                      },
                      "cross_platform": true
                    }
                  },
                  "spawn_command": {
                    "spawn_envs": {}
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
