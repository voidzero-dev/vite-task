// run --remote-cache=read-write local-only
{
  "graph": [
    {
      "key": [
        "<workspace>/",
        "local-only"
      ],
      "node": {
        "items": [
          {
            "kind": {
              "Leaf": {
                "Spawn": {
                  "cache_metadata": {
                    "spawn_fingerprint": {
                      "env_fingerprints": {
                        "fingerprinted_envs": {},
                        "untracked_env_config": [
                          "<default untracked envs>"
                        ]
                      }
                    },
                    "remote_cache": null
                  },
                  "spawn_command": {
                    "spawn_envs": {
                      "VP_REMOTE_CACHE": "read-write"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
