{
  "cache": {
    "scripts": true,
    "remote": {
      "url": "https://cache.example/projects/test"
    }
  },
  "tasks": {
    "build": {
      "command": "vtt print-file package.json",
      "cache": { "remote": true }
    },
    "local-only": {
      "command": "vtt print-file package.json",
      "cache": { "remote": false }
    },
    "synthetic": {
      "command": "vt tool print-file package.json",
      "cache": { "remote": false }
    },
    "cross-platform": {
      "command": "vtt print-file package.json",
      "cache": { "remote": { "crossPlatform": true } }
    },
    "synthetic-cross-platform": {
      "command": "vt tool print-file package.json",
      "cache": { "remote": { "crossPlatform": true } }
    },
    "tracked-controls": {
      "command": "vtt print-file package.json",
      "cache": {
        "env": ["VP_REMOTE_CACHE", "VP_REMOTE_CACHE_URL"]
      }
    }
  }
}
