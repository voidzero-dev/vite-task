initial content
> mkdir -p subfolder

> cp test.txt subfolder/test.txt

> vtt json-patch vite-task.json '[{"op":"add","path":"/tasks/test/cwd","value":"subfolder"}]' # change cwd

> vt run test # cache miss: cwd changed
