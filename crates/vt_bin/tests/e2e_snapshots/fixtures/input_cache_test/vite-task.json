{
  "tasks": {
    "positive-globs-only": {
      "command": "vtt print-file src/main.ts",
      "cache": { "input": ["src/**/*.ts"] }
    },
    "positive-globs-reads-unmatched": {
      "command": "vtt print-file src/main.ts src/utils.ts",
      "cache": { "input": ["src/main.ts"] }
    },
    "positive-negative-globs": {
      "command": "vtt print-file src/main.ts",
      "cache": { "input": ["src/**", "!src/**/*.test.ts"] }
    },
    "auto-only": {
      "command": "vtt print-file src/main.ts",
      "cache": {
        "input": [
          {
            "auto": true
          }
        ]
      }
    },
    "auto-with-negative": {
      "command": "vtt print-file src/main.ts dist/output.js",
      "cache": {
        "input": [
          {
            "auto": true
          },
          "!dist/**"
        ]
      }
    },
    "positive-auto-negative": {
      "command": "vtt print-file src/main.ts",
      "cache": {
        "input": [
          "package.json",
          {
            "auto": true
          },
          "!src/**/*.test.ts"
        ]
      }
    },
    "empty-inputs": {
      "command": "vtt print-file ./src/main.ts",
      "cache": { "input": [] }
    },
    "check-fspy-env-with-auto": {
      "command": "vtt print-env FSPY",
      "cache": {
        "input": [
          {
            "auto": true
          }
        ]
      }
    },
    "check-fspy-env-without-auto": {
      "command": "vtt print-env FSPY",
      "cache": {
        "input": ["src/**/*.ts"],
        "output": []
      }
    },
    "folder-input": {
      "command": "vtt print-file src/main.ts",
      "cache": { "input": ["src"] }
    },
    "folder-slash-input": {
      "command": "vtt print-file src/main.ts",
      "cache": { "input": ["src/"] }
    }
  }
}
