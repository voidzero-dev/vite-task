{
  "tasks": {
    "ignore-input": {
      "command": "node scripts/ignore_input.mjs",
      "cache": true
    },
    "ignore-input-manual-input": {
      "command": "node scripts/ignore_input.mjs",
      "cache": {
        "input": ["cache_like/input.txt"],
        "output": []
      }
    },
    "ignore-input-auto-manual-input": {
      "command": "node scripts/ignore_input.mjs",
      "cache": {
        "input": [{ "auto": true }, "cache_like/input.txt"],
        "output": []
      }
    },
    "ignore-output": {
      "command": "node scripts/ignore_output.mjs",
      "cache": {
        "output": [{ "auto": true }]
      }
    },
    "auto-output-explicit": {
      "command": "vtt write-file dist/auto.txt ok",
      "cache": {
        "input": [],
        "output": [{ "auto": true }]
      }
    },
    "auto-output-negative": {
      "command": "node scripts/auto_output_negative.mjs",
      "cache": {
        "input": [],
        "output": [{ "auto": true }, "!dist/skip.txt"]
      }
    },
    "auto-output-negative-overlap": {
      "command": "node scripts/auto_output_negative_overlap.mjs",
      "cache": {
        "input": [{ "auto": true }],
        "output": [{ "auto": true }, "!scratch/**"]
      }
    },
    "auto-output-default": {
      "command": "vtt write-file dist/default.txt ok",
      "cache": {
        "input": []
      }
    },
    "disable-cache": {
      "command": "node scripts/disable_cache.mjs",
      "cache": true
    },
    "disable-cache-explicit-input": {
      "command": "node scripts/disable_cache.mjs",
      "cache": {
        "input": [],
        "output": []
      }
    },
    "fetch-env": {
      "command": "node scripts/fetch_env.mjs PROBE_ENV",
      "cache": true
    },
    "fetch-missing-env": {
      "command": "node scripts/assert_undefined_env.mjs",
      "cache": true
    },
    "fetch-env-explicit-input": {
      "command": "node scripts/fetch_env.mjs PROBE_ENV",
      "cache": {
        "input": [],
        "output": []
      }
    },
    "fetch-envs": {
      "command": "node scripts/fetch_envs.mjs",
      "cache": true
    },
    "fetch-envs-prefix": {
      "command": "node scripts/fetch_envs.mjs --prefix",
      "cache": true
    },
    "fetch-envs-star-prefix": {
      "command": "node scripts/fetch_envs.mjs --prefix PROBE_*",
      "cache": true
    },
    "fetch-envs-untracked-noise": {
      "command": "node scripts/fetch_envs.mjs --glob \"{PROBE_*,ACTIONS_ORCHESTRATION_ID}\"",
      "cache": {
        "untrackedEnv": ["PROBE_NOISE_*", "ACTIONS_ORCHESTRATION_ID"]
      }
    },
    "fetch-envs-prefix-untracked-noise": {
      "command": "node scripts/fetch_envs.mjs --prefix",
      "cache": {
        "untrackedEnv": ["PROBE_NOISE_*"]
      }
    },
    "fetch-envs-all-untracked-except-vite": {
      "command": "node scripts/fetch_envs.mjs --prefix \"\" --print-prefix VITE_",
      "cache": {
        "untrackedEnv": ["*", "!VITE_*"]
      }
    },
    "fetch-env-explicitly-untracked": {
      "command": "node scripts/fetch_env.mjs PROBE_ENV",
      "cache": {
        "untrackedEnv": ["PROBE_ENV"]
      }
    },
    "fetch-envs-exact-explicitly-untracked": {
      "command": "node scripts/fetch_envs.mjs --glob PROBE_ENV",
      "cache": {
        "untrackedEnv": ["PROBE_ENV"]
      }
    },
    "fetch-env-declared-and-untracked": {
      "command": "node scripts/fetch_env.mjs PROBE_ENV",
      "cache": {
        "env": ["PROBE_ENV"],
        "untrackedEnv": ["PROBE_ENV"]
      }
    },
    "fetch-envs-removed-ignore": {
      "command": "node scripts/fetch_envs.mjs --prefix NEXT_PUBLIC_",
      "cache": {
        "input": [],
        "output": [],
        "untrackedEnv": ["NEXT_*"]
      }
    },
    "fetch-env-untracked": {
      "command": "node scripts/fetch_env.mjs --untracked PROBE_ENV",
      "cache": true
    },
    "fetch-envs-untracked": {
      "command": "node scripts/fetch_envs.mjs --untracked",
      "cache": true
    },
    "fetch-prefixed-env": {
      "command": "PREFIXED_ENV=from-command node scripts/fetch_env.mjs PREFIXED_ENV",
      "cache": true
    },
    "outer-prefixed": {
      "command": "PREFIXED_A=a vt run inner-prefixed",
      "cache": true
    },
    "inner-prefixed": {
      "command": "PREFIXED_B=b node scripts/fetch_env.mjs PREFIXED_A PREFIXED_B",
      "cache": true
    }
  }
}
