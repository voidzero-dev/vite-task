{
  "tasks": {
    "auto-with-negative": {
      "command": "vtt print-file src/main.ts dist/output.js",
      "cache": {
        "input": [
          {
            "auto": true
          },
          "!dist/**"
        ]
      }
    },
    "dotdot-positive": {
      "command": "vtt print-file ../shared/src/utils.ts",
      "cache": { "input": ["../shared/src/**"] }
    },
    "dotdot-positive-negative": {
      "command": "vtt print-file ../shared/src/utils.ts ../shared/dist/output.js",
      "cache": { "input": ["../shared/**", "!../shared/dist/**"] }
    },
    "dotdot-auto-negative": {
      "command": "vtt print-file ../shared/src/utils.ts ../shared/dist/output.js",
      "cache": {
        "input": [
          {
            "auto": true
          },
          "!../shared/dist/**"
        ]
      }
    }
  }
}
