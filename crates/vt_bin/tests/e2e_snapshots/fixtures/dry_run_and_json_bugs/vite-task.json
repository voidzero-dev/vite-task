{
  "tasks": {
    "build": {
      "command": "vtt print-file src/a.txt",
      "cache": {
        "input": ["src/**"]
      }
    },
    "same-command": {
      "command": "vtt print-file src/a.txt",
      "dependsOn": ["build"],
      "cache": {
        "input": ["src/**"]
      }
    },
    "emit": {
      "command": "vtt write-file dist/out.txt built",
      "cache": true
    },
    "up-and-back": {
      "command": "vtt print-cwd",
      "cwd": "src/..",
      "cache": false
    },
    "cd-and-back": {
      "command": "cd src && cd .. && vtt print-cwd",
      "cache": false
    },
    "outside": {
      "command": "vtt print-cwd",
      "cwd": "..",
      "cache": false
    },
    "tool": {
      "command": "src/../bin/tool",
      "cache": false
    }
  }
}
