{
  "tasks": {
    "build": {
      "command": "vtt write-file dist/output.txt built",
      "cache": {
        "input": ["src/**"],
        "output": ["dist/**"]
      }
    },
    "check": {
      "command": "vtt print checked",
      "cache": {
        "input": ["src/**"],
        "output": []
      }
    },
    "all": {
      "command": "vt run build && vt run check"
    }
  }
}
